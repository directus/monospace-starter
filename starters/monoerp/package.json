{
  "name": "monoerp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node infra/compose-sync.mjs && vp dev",
    "generate": "vp run --filter @monoerp/web generate",
    "generate:routes": "vp run --filter @monoerp/web generate:routes",
    "generate:schemas": "vp run --filter @monoerp/web generate:schemas",
    "generate:types": "vp run --filter @monoerp/web generate:types",
    "setup:all": "node infra/monospace/setup/setup.mjs",
    "db:migrate": "docker compose run --rm --no-deps --entrypoint sh crm-postgres /infra/postgres/migrate.sh && node infra/monospace/setup/connector-step.mjs migrate",
    "aws:plan": "vp run --filter @monoerp/infra plan",
    "aws:deploy": "vp run --filter @monoerp/infra deploy",
    "aws:destroy": "vp run --filter @monoerp/infra destroy",
    "aws:keys": "vp run --filter @monoerp/infra keys",
    "aws:license": "vp run --filter @monoerp/infra license",
    "aws:db-init": "vp run --filter @monoerp/infra db-init",
    "aws:setup": "vp run --filter @monoerp/infra setup",
    "aws:probe": "vp run --filter @monoerp/infra probe",
    "aws:mail": "vp run --filter @monoerp/infra mail",
    "aws:restore-test": "vp run --filter @monoerp/infra restore-test",
    "aws:github-oidc": "vp run --filter @monoerp/infra github-oidc",
    "setup:sources": "node infra/monospace/setup/sources.mjs",
    "setup:introspect": "node infra/monospace/setup/introspect-sources.mjs",
    "setup:schema": "node infra/monospace/setup/apply-schema.mjs",
    "schema:export": "node infra/monospace/setup/export-schema.mjs",
    "build": "vp build",
    "build:extensions": "node infra/monospace/setup/build-extensions.mjs",
    "start": "vp run --filter @monoerp/web start",
    "typecheck": "vp run --filter @monoerp/web typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "check": "node tools/pieces.mjs check && vp check",
    "prepare": "node tools/prepare.mjs",
    "compose:sync": "node infra/compose-sync.mjs",
    "pieces:check": "node tools/pieces.mjs check",
    "pieces:remove": "node tools/pieces.mjs remove",
    "setup:audit-relations": "node infra/monospace/setup/audit-user-relations.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "vite-plus": "catalog:",
    "zod": "4.5.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
