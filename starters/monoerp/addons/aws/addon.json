{
  "format": "urn:monospace:manifest:addon:1",
  "kind": "addon",
  "id": "aws",
  "label": "AWS deploy",
  "description": "Optional deployment tools",
  "ownedPaths": [
    "addons/aws",
    "infra/aws",
    ".github/workflows/deploy.yml",
    "patches/alchemy@2.0.0-beta.79.patch"
  ],
  "packageEntries": [
    {
      "path": "package.json",
      "section": "scripts",
      "names": ["aws"]
