{
  "format": "urn:monospace:manifest:starter:1",
  "kind": "starter",
  "id": "starter",
  "label": "monoERP starter",
  "description": "Shared app shell, authentication, database, and setup",
  "ownedPaths": [
    ".dockerignore",
    ".env.example",
    ".github/assets",
    ".github/workflows/check.yml",
    ".gitignore",
    ".node-version",
    ".npmrc",
    ".vite-hooks",
    ".vscode",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "apps/web/Dockerfile",
    "apps/web/components.json",
    "apps/web/monospace.config.ts",
    "apps/web/package.json",
    "apps/web/scripts",
    "apps/web/server",
    "apps/web/src/components",
    "apps/web/src/generated",
    "apps/web/src/hooks",
    "apps/web/src/lib",
    "apps/web/src/modules/boundaries.test.ts",
    "apps/web/src/modules/features.ts",
    "apps/web/src/modules/index.ts",
    "apps/web/src/modules/pages.ts",
    "apps/web/src/modules/types.ts",
    "apps/web/src/react-css.d.ts",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/src/router.tsx",
    "apps/web/src/routes/__root.tsx",
    "apps/web/src/routes/_app.tsx",
    "apps/web/src/routes/_app/index.tsx",
    "apps/web/src/routes/_app/settings.account.tsx",
    "apps/web/src/routes/_app/settings.index.tsx",
    "apps/web/src/routes/_app/settings.tsx",
    "apps/web/src/routes/login.tsx",
    "apps/web/src/settings",
    "apps/web/src/shell",
    "apps/web/src/styles.css",
    "apps/web/src/test",
    "apps/web/test",
    "apps/web/tsconfig.json",
    "apps/web/tsr.config.json",
    "apps/web/vite.config.ts",
    "apps/web/vitest.browser.config.ts",
    "connectors/README.md",
    "docker-compose.yml",
    "docs",
    "infra/caddy",
    "infra/compose-sync.mjs",
    "infra/compose-sync.test.mjs",
    "infra/manifests.d.mts",
    "infra/manifests.mjs",
    "infra/monospace",
    "infra/postgres",
    "infra/setup",
    "package.json",
    "patches/@monospace__cli@0.2.1.patch",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "starter.json",
    "tools/app.mjs",
    "tools/app.test.mjs",
    "tools/manifest-fixtures.d.mts",
    "tools/manifest-fixtures.mjs",
    "tools/manifest-schema.mjs",
    "tools/prepare.mjs",
    "vite.config.ts"
  ],
  "requires": [],
  "sourceRoots": [
    "apps/web/src/routes",
    "apps/web/src/modules",
    "infra/modules",
    "connectors",
    "addons"
  ],
  "ignorePaths": [
    "dist",
    ".output",
    ".cache",
    "apps/web/dist",
    "apps/web/.output",
    "apps/web/.nitro",
    "apps/web/.tanstack"
  ],
  "nextSteps": {
    "create": [
      {
        "command": ["cp", "-n", ".env.example", ".env"]
      },
      {
        "command": ["docker", "compose", "up", "-d", "--wait", "--wait-timeout", "180"]
      },
      {
        "script": "setup:all"
      },
      {
        "script": "generate:routes",
        "when": "choices-changed"
      },
      {
        "script": "generate",
        "when": "choices-changed"
      },
      {
        "script": "dev"
      }
    ],
    "remove": [
      {
        "command": ["pnpm", "install"]
      },
      {
        "script": "app:doctor"
      },
      {
        "command": [
          "docker",
          "compose",
          "up",
          "-d",
          "--wait",
          "--wait-timeout",
          "180",
          "--remove-orphans"
        ]
      },
      {
        "script": "setup:all"
      },
      {
        "script": "generate:routes"
      },
      {
        "script": "generate"
      }
    ]
  }
}
