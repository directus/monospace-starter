    "auditColumns": {
      "workforce_plan_roles": ["created_by", "updated_by"],
      "role_requests": ["created_by", "updated_by"],
      "requisitions": ["created_by", "updated_by"],
      "candidates": ["created_by", "updated_by"],
      "applications": ["created_by", "updated_by"],
      "candidate_notes": ["created_by", "updated_by"],
      "candidate_files": ["created_by"],
      "candidate_messages": ["created_by"],
      "interviews": ["created_by", "updated_by"],
      "scorecards": ["created_by", "updated_by"],
      "offers": ["created_by", "updated_by"],
      "email_templates": ["created_by", "updated_by"]
    },
    "setup": {
      "afterSchema": [
        {
          "title": "ATS demo people",
          "script": "ats-people.mjs"
        },
        {
          "title": "ATS public careers access",
          "script": "ats-public.mjs"
        }
      ]
    },
    "demoUserCredential": "AtsDemoCredentials"
  }
}
