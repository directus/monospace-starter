{
  "$schema": "https://monospace.io/schemas/starter/v1/module.json",
  "label": "ATS",
  "description": "Jobs, candidates, interviews and offers",
  "requires": ["checkr"],
  "x-monoerp": {
    "collections": [
      "departments",
      "jobLevels",
      "hiringLocations",
      "workforcePlanRoles",
      "roleRequests",
      "requisitions",
      "interviewStages",
      "candidates",
      "applications",
      "candidateNotes",
      "candidateFiles",
      "candidateMessages",
      "interviews",
      "interviewParticipants",
      "scorecards",
      "offers",
      "approvals",
      "emailTemplates",
      "auditEvents",
      "publicApplications",
      "checkrCandidates",
      "checkrReports",
      "checkrInvitations",
      "checkrPackages"
    ],
    "writes": [
      "applications",
      "approvals",
      "candidateFiles",
      "candidateMessages",
      "candidateNotes",
      "candidates",
      "departments",
      "emailTemplates",
      "hiringLocations",
      "interviewParticipants",
      "interviewStages",
      "interviews",
      "jobLevels",
      "offers",
      "publicApplications",
      "requisitions",
      "roleRequests",
      "scorecards",
      "workforcePlanRoles"
