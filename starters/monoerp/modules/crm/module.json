{
  "format": "urn:monospace:manifest:module:1",
  "kind": "module",
  "id": "crm",
  "label": "CRM",
  "description": "Organizations, contacts, and deals.",
  "ownedPaths": [
    "modules/crm",
    "apps/web/src/modules/crm",
    "infra/modules/crm",
    "apps/web/src/routes/_app/crm",
    "apps/web/src/routes/_app/settings.crm.pipeline-stages.tsx"
  ],
  "requires": [],
  "x-monoerp": {
    "app": "apps/web/src/modules/crm",
    "infra": "infra/modules/crm",
    "settings": ["apps/web/src/routes/_app/settings.crm.pipeline-stages.tsx"],
    "order": 10,
    "collections": [
      "organizations",
      "contacts",
      "affiliations",
      "deals",
      "pipelineStages",
      "activities",
      "attachments"
    ],
    "schemas": ["attachments", "affiliations", "contacts", "activities", "deals", "organizations"],
    "optional": ["portal", "stripe"],
    "auditTables": {
      "organizations": ["owner_user_id", "created_by", "updated_by"],
      "contacts": ["owner_user_id", "created_by", "updated_by"],
      "affiliations": ["created_by", "updated_by"],
      "deals": ["owner_user_id", "created_by", "updated_by"],
      "activities": ["owner_user_id", "created_by", "updated_by"],
      "attachments": ["created_by"]
    },
    "setup": {
      "beforeSchema": [],
      "afterSchema": [
        {
          "title": "Activity owners",
          "script": "backfill-owners.mjs"
        }
      ]
    },
    "schemaFiles": ["infra/modules/crm/monospace/schema/app.json"]
  }
}
