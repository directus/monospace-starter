# Local development defaults. Replace all credentials in shared environments.
APP_PORT=3000
MONOSPACE_PORT=8100
MONOSPACE_SYSTEM_POSTGRES_PORT=5434
CRM_POSTGRES_PORT=5433
CUSTOMER_MYSQL_PORT=3307
MAILPIT_PORT=8025
STRIPE_PORT=4010
# Change every port above when running another copy.
# Compose uses the folder name. Optional override:
# COMPOSE_PROJECT_NAME=my-app

MONOSPACE_ADMIN_EMAIL=admin@example.com
MONOSPACE_ADMIN_PASSWORD=monospace
# Optional locally: without a key Monospace runs on the free tier (1 workspace, 3 users,
# no custom roles or policies), which monoERP runs on. Leave the line commented out when unset;
# Monospace rejects an empty key. Required by the AWS deploy.
# MONOSPACE_LICENSE__KEY=
MONOSPACE_SYSTEM_DB_PASSWORD=monospace
CRM_DB_PASSWORD=monospace
CUSTOMER_MYSQL_ROOT_PASSWORD=monospace
PORTAL_READER_PASSWORD=monospace
# Override the installed modules' connector selection. Unset to use their declarations;
# empty selects none. Only connector folders that exist are connected. Missing sources show
# as not set up in the app. Compose services follow folders, not this selection.
# OPTIONAL_SOURCES=portal,stripe

# Optional: logo.dev token for company logos (local and AWS).
LOGO_DEV_TOKEN=
# Optional, AWS deploys: where CloudWatch alarms are emailed. AWS sends a confirmation link first.
ALARM_EMAIL=
# Optional, AWS deploys: the GitHub repo allowed to deploy, as its OIDC subject prefix (see infra/aws/README.md).
GITHUB_OIDC_SUBJECT=
