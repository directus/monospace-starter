# Local development defaults. Replace all credentials in shared environments.
APP_PORT=3000
MONOSPACE_PORT=8100
MONOSPACE_SYSTEM_POSTGRES_PORT=5434
APP_POSTGRES_PORT=5433
CUSTOMER_MYSQL_PORT=3307
MAILPIT_PORT=8025
STRIPE_PORT=4010
# Change every port above when running another copy.
# Compose uses the folder name. Optional override:
# COMPOSE_PROJECT_NAME=my-app

MONOSPACE_ADMIN_EMAIL=admin@example.com
MONOSPACE_ADMIN_PASSWORD=monospace
# Optional locally; see docs/monospace.md#license-key-and-the-free-tier.
# Leave commented out when unset; Monospace rejects an empty key.
# MONOSPACE_LICENSE__KEY=
MONOSPACE_SYSTEM_DB_PASSWORD=monospace
APP_DB_PASSWORD=monospace
CUSTOMER_MYSQL_ROOT_PASSWORD=monospace
PORTAL_READER_PASSWORD=monospace
# Optional connector selection; see connectors/README.md#source-selection.
# OPTIONAL_SOURCES=portal,stripe

# Optional: logo.dev token for company logos.
LOGO_DEV_TOKEN=

# Optional external services and database settings; see docs/getting-started.md.
# STRIPE_API_KEY=sk_test_...
# STRIPE_API_BASE=https://api.stripe.com
# APP_DB_HOST=host.docker.internal
# APP_DB_INTERNAL_PORT=5432
# APP_DB_USER=app
# APP_DB_NAME=app
# DB_SSL_MODE=require
# MONOSPACE_PROXY_TARGET=http://127.0.0.1:8100
